<?xml version="1.0" encoding="UTF-8"?>
<!--
  Routes are listed only if they exist in src/App.tsx. /agents/marketplace was
  listed here and does not exist - the page went with T7 - so crawlers were being
  pointed at a 404.

  The host is the managed deployment. A sitemap's <loc> values must be absolute,
  so a self-hosted install cannot reuse this file as-is: replace the host, or
  generate the file at build time from the deployment's own URL.

  lastmod is deliberately omitted rather than hand-maintained: every date here
  said 2025-01-09 regardless of when a page changed, and a stale lastmod teaches
  crawlers to distrust the file. The element is optional.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.4genthub.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.4genthub.com/docs</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://www.4genthub.com/help-setup</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://www.4genthub.com/login</loc>
    <changefreq>yearly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://www.4genthub.com/register</loc>
    <changefreq>yearly</changefreq>
    <priority>0.7</priority>
  </url>
</urlset>
