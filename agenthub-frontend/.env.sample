# Frontend Environment Configuration Sample
# Copy this file to .env.development for local development

# API Configuration
VITE_API_URL=http://localhost:8000

# WebSocket Configuration - CRITICAL for real-time features
# MUST be set for WebSocket connections to work
VITE_WS_URL=ws://localhost:8000

# Environment
VITE_ENV=development

# Debug Mode
VITE_DEBUG=true

# Application Configuration
VITE_APP_NAME=agenthub

# WebSocket Tuning Parameters (optional)
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
VITE_WS_RECONNECT_DELAY=1000
VITE_WS_AI_BUFFER_TIMEOUT=500
VITE_WS_MAX_RECONNECT_DELAY=30000
VITE_WS_HEARTBEAT_INTERVAL=30000

# For production deployment:
# Set these environment variables in CapRover or your deployment system