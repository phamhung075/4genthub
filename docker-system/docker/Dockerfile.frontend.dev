# Development Frontend Dockerfile for agenthub
# Based on production Dockerfile but optimized for development
# Note: Hot-reload disabled in Docker - rebuild container for code changes

FROM node:20-alpine

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Build arguments grouped by frequency of change (optimization for Docker layer caching)
# Group 1: Static/Rarely Changed - Environment type, ports, defaults
ARG NODE_ENV=development
ARG VITE_ENV=development
ARG FRONTEND_PORT=3800

# Group 2: Feature Flags/Config - Build and development settings (change occasionally)
ARG NODE_OPTIONS="--max-old-space-size=2048"
ARG VITE_BUILD_TIME=development
ARG VITE_BUILD_SHA=development

# Group 3: External Services - URLs and connection settings (change per deployment)
ARG VITE_API_URL=http://localhost:8000
ARG VITE_BACKEND_URL=http://localhost:8000
ARG VITE_KEYCLOAK_URL=https://your-keycloak-server.com
ARG VITE_KEYCLOAK_REALM=your-realm
ARG VITE_KEYCLOAK_CLIENT_ID=your-client-id

# Group 4: Feature Flags - Application behavior toggles
ARG VITE_DISABLE_AUTH=false
ARG VITE_ENABLE_MARKETPLACE=true

# Convert build args to environment variables with defaults (consolidated for faster builds)
# Group 1: Node and environment configuration
ENV NODE_ENV=${NODE_ENV} \
    NODE_OPTIONS=${NODE_OPTIONS} \
    VITE_ENV=${VITE_ENV}

# Group 2: API and backend configuration
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_BACKEND_URL=${VITE_BACKEND_URL}

# Group 3: Keycloak authentication configuration
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL} \
    VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM} \
    VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}

# Group 4: Build metadata
ENV VITE_BUILD_TIME=${VITE_BUILD_TIME} \
    VITE_BUILD_SHA=${VITE_BUILD_SHA}

# Group 5: Feature flags
ENV VITE_DISABLE_AUTH=${VITE_DISABLE_AUTH} \
    VITE_ENABLE_MARKETPLACE=${VITE_ENABLE_MARKETPLACE}

# Copy package files from frontend directory (project uses pnpm)
COPY agenthub-frontend/package.json ./

# Install dependencies including dev dependencies for development
# Install pnpm globally
RUN npm install -g pnpm

# Copy pnpm-lock.yaml
COPY agenthub-frontend/pnpm-lock.yaml ./

# Install dependencies with pnpm
RUN pnpm install

# Install serve globally for serving built files
# Configure pnpm global bin directory
ENV PNPM_HOME="/usr/local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Create pnpm home directory
RUN mkdir -p $PNPM_HOME

# Install serve globally
RUN pnpm add -g serve

# Copy frontend source code
COPY agenthub-frontend/ .

# Create a development startup script
RUN cat <<'EOF' > /app/start-dev.sh
#!/bin/sh
set -e

echo "Starting agenthub Frontend Development Server..."
echo "================================================"

# Validate required environment variables
REQUIRED_VARS="VITE_API_URL VITE_BACKEND_URL"
MISSING_VARS=""

for VAR in $REQUIRED_VARS; do
    eval VALUE=\$$VAR
    if [ -z "$VALUE" ]; then
        MISSING_VARS="$MISSING_VARS $VAR"
        echo "❌ Missing required variable: $VAR"
    else
        echo "✅ $VAR: $VALUE"
    fi
done

# Check optional but important variables
OPTIONAL_VARS="VITE_KEYCLOAK_URL VITE_KEYCLOAK_REALM VITE_KEYCLOAK_CLIENT_ID"
for VAR in $OPTIONAL_VARS; do
    eval VALUE=\$$VAR
    if [ -z "$VALUE" ]; then
        echo "⚠️  Optional variable not set: $VAR (Auth may not work properly)"
    else
        echo "✅ $VAR: $VALUE"
    fi
done

if [ -n "$MISSING_VARS" ]; then
    echo ""
    echo "❌ ERROR: Missing required environment variables:$MISSING_VARS"
    echo "Please ensure .env.dev file contains all required variables"
    exit 1
fi

# Validate URLs
for VAR in VITE_API_URL VITE_BACKEND_URL VITE_KEYCLOAK_URL; do
    eval VALUE=\$$VAR
    if [ -n "$VALUE" ]; then
        if ! echo "$VALUE" | grep -qE '^https?://'; then
            echo "⚠️  WARNING: $VAR should be a valid URL, got: $VALUE"
        fi
    fi
done

echo ""
echo "Configuration Summary:"
echo "  Backend URL: ${VITE_BACKEND_URL}"
echo "  API URL: ${VITE_API_URL}"
echo "  Environment: ${VITE_ENV:-development}"
echo "  Keycloak URL: ${VITE_KEYCLOAK_URL:-Not configured}"
echo "  Keycloak Realm: ${VITE_KEYCLOAK_REALM:-Not configured}"
echo "  Keycloak Client: ${VITE_KEYCLOAK_CLIENT_ID:-Not configured}"
echo "  Debug Mode: ${VITE_ENABLE_DEBUG:-false}"
echo "  Auth Bypass: ${VITE_DISABLE_AUTH:-false}"
echo "  Marketplace Enabled: ${VITE_ENABLE_MARKETPLACE:-true}"
if [ "${VITE_DISABLE_AUTH:-false}" = "true" ]; then
    echo "  ⚠️  WARNING: Authentication is DISABLED"
    echo "  ⚠️  This should ONLY be used in local development!"
fi
echo "================================================"

# Build and serve the application (no hot-reload in Docker)
echo ""
echo "🔨 Building frontend application..."
pnpm run build || {
    echo "❌ ERROR: Frontend build failed"
    echo "Check that all dependencies are installed and code is valid"
    exit 1
}

echo ""
echo "🚀 Starting frontend server on port 3800..."
exec serve -s build -l 3800
EOF

RUN chmod +x /app/start-dev.sh

# Expose Vite dev server port
EXPOSE 3800

# Health check for dev server
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3800/ || exit 1

# No volume needed since hot-reload is disabled

# Start development server
CMD ["/app/start-dev.sh"]