            assert server is not None

            # Verify no authentication tools were registered
            # (create_authentication_tools should not be called when auth is disabled)
            assert mock_tool_registry_instance.mount_tools_to_server.called


class TestASGIResponseHandling:
    """Test ASGI response handling with duplicate messages (lines 130-147)"""

    @pytest.mark.asyncio
    async def test_duplicate_http_response_start_handling(self):
        """
        Test that duplicate http.response.start messages are handled gracefully.

        ASGI spec allows some applications to send duplicate start messages.
        The middleware should:
        1. Send the first message normally
        2. Log duplicate detection (line 133)
        3. Continue processing without blocking (line 127)

        Coverage: Lines 130-137 (duplicate response.start detection)
        Edge Case: Duplicate ASGI response.start messages
        """
        # Create mock app that sends duplicate response.start
        async def duplicate_start_app(scope, receive, send):
            """Mock app that sends duplicate http.response.start"""
            # Send first response.start
            await send({
                "type": "http.response.start",
                "status": 200,
                "headers": [[b"content-type", b"application/json"]]
            })
            # Send duplicate response.start (some frameworks do this)
            await send({
                "type": "http.response.start",
                "status": 200,
                "headers": [[b"content-type", b"application/json"]]
            })
            # Send response body
            await send({
                "type": "http.response.body",
                "body": b'{"status": "ok"}',
                "more_body": False
            })

        # Create middleware with the duplicate app
        middleware = DebugLoggingMiddleware(duplicate_start_app)

        # Mock scope for HTTP request
        scope = {
            "type": "http",
            "method": "GET",
            "path": "/test",
            "query_string": b"",
            "server": ("localhost", 8000),
            "client": ("127.0.0.1", 12345),
            "headers": []
        }

        # Track messages sent
        sent_messages = []

        async def mock_receive():
            """Mock receive that returns request message"""
            return {"type": "http.request", "body": b""}

        async def mock_send(message):
            """Mock send that tracks all messages"""
            sent_messages.append(message)

        # Execute middleware (should not raise exception)
        await middleware(scope, mock_receive, mock_send)

        # Verify both start messages were sent (middleware doesn't block duplicates)
        response_starts = [m for m in sent_messages if m["type"] == "http.response.start"]
        assert len(response_starts) == 2, "Both response.start messages should be sent"

        # Verify response body was sent
        response_bodies = [m for m in sent_messages if m["type"] == "http.response.body"]
        assert len(response_bodies) == 1, "Response body should be sent once"


    @pytest.mark.asyncio
    async def test_response_body_without_more_body_flag(self):
        """
        Test response completion detection with missing more_body flag.

        Line 144: if not message.get("more_body", False) and not response_completed

        When more_body is missing (defaults to False), response should be logged once.

        Coverage: Line 144 (response completion detection)
        Edge Case: Missing more_body flag in response.body message
        """
        # Create mock app that sends response without explicit more_body
        async def minimal_response_app(scope, receive, send):
            """Mock app with minimal response (no explicit more_body)"""
            await send({
                "type": "http.response.start",
                "status": 200,
                "headers": [[b"content-type", b"text/plain"]]
            })
            # Send body without more_body key (should default to False)
            await send({
                "type": "http.response.body",
                "body": b"OK"
                # more_body is missing - defaults to False per ASGI spec
            })

        # Create middleware
        middleware = DebugLoggingMiddleware(minimal_response_app)

        # Mock scope
        scope = {
            "type": "http",
            "method": "POST",
            "path": "/api/test",
            "query_string": b"",
            "server": ("localhost", 8000),
            "client": ("192.168.1.1", 54321),
            "headers": [[b"content-type", b"application/json"]]
        }

        sent_messages = []

        async def mock_receive():
            return {"type": "http.request", "body": b'{"test": true}'}

        async def mock_send(message):
            sent_messages.append(message)

        # Execute middleware
        await middleware(scope, mock_receive, mock_send)

        # Verify response was sent correctly
        assert len(sent_messages) == 2  # start + body
        assert sent_messages[0]["type"] == "http.response.start"
        assert sent_messages[1]["type"] == "http.response.body"

        # Verify more_body handling
        body_message = sent_messages[1]
        # more_body should be missing or False
        assert body_message.get("more_body", False) is False


