# Performance and resilience test
class TestASGIResilience:
    """Test ASGI resilience under stress conditions"""

    @pytest.mark.asyncio
    async def test_middleware_handles_large_request_body(self):
        """
        Test middleware handling of large request bodies.

        Coverage: Lines 106-114 (request body capture)
        Edge Case: Large request body (multiple chunks)
        """
        # Create mock app
        async def echo_app(scope, receive, send):
            """Mock app that echoes back the request"""
            await send({
                "type": "http.response.start",
                "status": 200,
                "headers": [[b"content-type", b"application/json"]]
            })
            await send({
                "type": "http.response.body",
                "body": b'{"received": true}',
                "more_body": False
            })

        middleware = DebugLoggingMiddleware(echo_app)

        # Create large request body (simulate chunked transfer)
        large_body = b"x" * 10000  # 10KB body
        chunks = [large_body[i:i+1000] for i in range(0, len(large_body), 1000)]

        scope = {
            "type": "http",
            "method": "POST",
            "path": "/api/upload",
            "query_string": b"",
            "server": ("localhost", 8000),
            "client": ("127.0.0.1", 12345),
            "headers": [[b"content-type", b"application/octet-stream"]]
        }

        chunk_index = [0]  # Use list to allow modification in closure

        async def mock_receive():
            """Mock receive that returns body in chunks"""
            if chunk_index[0] < len(chunks):
                chunk = chunks[chunk_index[0]]
                chunk_index[0] += 1
                return {
                    "type": "http.request",
                    "body": chunk,
                    "more_body": chunk_index[0] < len(chunks)
                }
            return {"type": "http.request", "body": b""}

        sent_messages = []

        async def mock_send(message):
            sent_messages.append(message)

        # Execute middleware with large chunked body
        await middleware(scope, mock_receive, mock_send)

        # Verify request was processed successfully
        assert len(sent_messages) >= 2  # At least start + body
        assert sent_messages[0]["type"] == "http.response.start"


    @pytest.mark.asyncio
    async def test_middleware_handles_non_http_scope(self):
        """
        Test middleware skips non-HTTP requests (WebSocket, etc).

        Coverage: Lines 71-73 (non-HTTP scope handling)
        Edge Case: WebSocket or other non-HTTP ASGI scope
        """
        # Create mock WebSocket app
        async def ws_app(scope, receive, send):
            """Mock WebSocket app"""
            await send({"type": "websocket.accept"})

        middleware = DebugLoggingMiddleware(ws_app)

        # WebSocket scope
        scope = {
            "type": "websocket",
            "path": "/ws",
            "client": ("127.0.0.1", 12345)
        }

        sent_messages = []

        async def mock_receive():
            return {"type": "websocket.connect"}

        async def mock_send(message):
            sent_messages.append(message)

        # Execute middleware (should pass through without HTTP processing)
        await middleware(scope, mock_receive, mock_send)

        # Verify WebSocket accept was sent
        assert len(sent_messages) == 1
        assert sent_messages[0]["type"] == "websocket.accept"
