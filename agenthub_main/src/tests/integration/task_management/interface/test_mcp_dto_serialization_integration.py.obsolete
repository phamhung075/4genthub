"""
Integration Tests for MCP Endpoint DTO Serialization

Tests Phase 1 changes to verify MCP endpoints return correct structure without
removed fields (emoji, count) and correctly handle include_context parameter.

Phase 1 Backend Implementation:
- Layer 2 (DTOs): Removed emoji and count fields from serialization
- Layer 3 (Services): No emoji mapping or count calculation
- Layer 4 (Controllers): include_context parameter support

Test Coverage:
- Response structure (no emoji/count fields)
- include_context parameter behavior (default False, explicit True)
- List operations return clean structure
- All CRUD operations maintain structure

Created by: test-orchestrator-agent
Date: 2025-10-26
Purpose: Integration testing for Phase 1 backend changes
"""

import pytest
import uuid
from unittest.mock import Mock, patch, AsyncMock
from typing import Dict, Any

from fastmcp.task_management.interface.mcp_controllers.task_mcp_controller.task_mcp_controller import TaskMCPController
from fastmcp.task_management.application.factories.task_facade_factory import TaskFacadeFactory
from fastmcp.task_management.application.facades.task_application_facade import TaskApplicationFacade
from fastmcp.task_management.domain.entities.task import Task
from fastmcp.task_management.domain.entities.subtask import Subtask
from fastmcp.task_management.domain.value_objects.task_id import TaskId
from fastmcp.task_management.domain.value_objects.priority import Priority
from fastmcp.task_management.domain.value_objects.task_status import TaskStatus


# Test markers
pytestmark = [
    pytest.mark.integration,
    pytest.mark.asyncio
]


class TestMCPTaskEndpointResponseStructure:
    """Test manage_task endpoint returns responses without removed fields"""

    @pytest.fixture
    def controller_with_mock_facade(self, monkeypatch):
        """Create controller with mocked facade and disabled auth"""
        # Disable authentication for tests
        monkeypatch.setenv('AUTH_ENABLED', 'false')

        mock_task_facade_factory = Mock(spec=TaskFacadeFactory)
        mock_task_facade = Mock(spec=TaskApplicationFacade)
        mock_task_facade_factory.create_task_facade.return_value = mock_task_facade

        controller = TaskMCPController(
            facade_service_or_factory=mock_task_facade_factory
        )

        return controller, mock_task_facade

    @pytest.mark.asyncio
    async def test_manage_task_get_no_emoji_fields(self, controller_with_mock_facade):
        """
        Verify manage_task GET endpoint doesn't return emoji fields

        Tests:
        - priority_emoji NOT in response
        - status_emoji NOT in response
        - priority (string) IS in response
        - status (string) IS in response
        """
        controller, mock_facade = controller_with_mock_facade

        # Create test task
        test_task_id = TaskId(str(uuid.uuid4()))
        test_task = Task(
            id=test_task_id,
            title="Test task",
            description="Test task description",
            git_branch_id=uuid.uuid4(),
            status=TaskStatus.in_progress(),
            priority=Priority.high(),
            assignees=["coding-agent"]
        )

        # Mock facade to return task
        mock_facade.get_task.return_value = test_task

        # Call controller (auth disabled via fixture)
        result = await controller.manage_task(
            action="get",
            task_id=str(test_task_id)
        )

        # Debug output
        if not result.get('success'):
            print(f"Test failed - Result: {result}")

        # Verify response structure
        assert result['success'] is True, f"Expected success, got: {result}"
        task_data = result['task']

        # Should NOT have emoji fields
        assert 'priority_emoji' not in task_data, "priority_emoji should not be in response"
        assert 'status_emoji' not in task_data, "status_emoji should not be in response"

        # Should have base string fields
        assert 'priority' in task_data
        assert task_data['priority'] == 'high'
        assert 'status' in task_data
        assert task_data['status'] == 'in_progress'

    @pytest.mark.asyncio
    async def test_manage_task_get_no_count_fields(self, controller_with_mock_facade):
        """
        Verify manage_task GET endpoint doesn't return count fields

        Tests:
        - subtask_count NOT in response
        - assignees_count NOT in response
        - dependency_count NOT in response
        - subtasks array IS in response
        - assignees array IS in response
        - dependencies array IS in response
        """
        controller, mock_facade = controller_with_mock_facade

        # Create test task with subtasks and assignees
        test_task_id = TaskId(str(uuid.uuid4()))
        subtask_ids = [uuid.uuid4() for _ in range(3)]
        test_task = Task(
            id=test_task_id,
            title="Test task with subtasks",
            description="Test task with multiple subtasks and assignees",
            git_branch_id=uuid.uuid4(),
            status=TaskStatus.in_progress(),
            priority=Priority.high(),
            assignees=["coding-agent", "debugger-agent", "test-orchestrator-agent"],
            subtasks=subtask_ids,
            dependencies=[uuid.uuid4(), uuid.uuid4()]
        )

        # Mock facade to return task
        mock_facade.get_task.return_value = test_task

        # Call controller (auth disabled via fixture)
        result = await controller.manage_task(
            action="get",
            task_id=str(test_task_id)
        )

        # Verify response structure
        assert result['success'] is True
        task_data = result['task']

        # Should NOT have count fields
        assert 'subtask_count' not in task_data, "subtask_count should not be in response"
        assert 'assignees_count' not in task_data, "assignees_count should not be in response"
        assert 'dependency_count' not in task_data, "dependency_count should not be in response"

        # Should have actual arrays
        assert 'subtasks' in task_data
        assert isinstance(task_data['subtasks'], list)
        assert len(task_data['subtasks']) == 3

        assert 'assignees' in task_data
        assert isinstance(task_data['assignees'], list)
        assert len(task_data['assignees']) == 3

        assert 'dependencies' in task_data
        assert isinstance(task_data['dependencies'], list)
        assert len(task_data['dependencies']) == 2

    @pytest.mark.asyncio
    async def test_manage_task_list_no_count_fields(self, controller_with_mock_facade):
        """
        Verify manage_task LIST endpoint doesn't return count fields

        Tests:
        - Multiple tasks in list
        - No count fields in any task
        - Arrays present in all tasks
        """
        controller, mock_facade = controller_with_mock_facade

        # Create test tasks
        test_branch_id = uuid.uuid4()
        test_tasks = [
            Task(
                id=TaskId(str(uuid.uuid4())),
                title=f"Test task {i}",
                description=f"Description for test task {i}",
                git_branch_id=test_branch_id,
                status=TaskStatus.todo(),
                priority=Priority.medium(),
                assignees=["coding-agent"],
                subtasks=[uuid.uuid4() for _ in range(i + 1)]
            )
            for i in range(3)
        ]

        # Mock facade to return tasks
        mock_facade.list_tasks.return_value = test_tasks

        # Call controller (auth disabled via fixture)
        result = await controller.manage_task(
            action="list",
            git_branch_id=str(test_branch_id)
        )

        # Verify response structure
        assert result['success'] is True
        tasks_data = result['tasks']
        assert len(tasks_data) == 3

        # Check each task
        for task_data in tasks_data:
            # Should NOT have count fields
            assert 'subtask_count' not in task_data
            assert 'assignees_count' not in task_data
            assert 'dependency_count' not in task_data

            # Should have arrays
            assert 'subtasks' in task_data
            assert isinstance(task_data['subtasks'], list)

    @pytest.mark.asyncio
    async def test_manage_task_create_no_emoji_count_fields(self, controller_with_mock_facade):
        """
        Verify manage_task CREATE returns clean structure

        Tests:
        - Created task has no emoji/count fields
        """
        controller, mock_facade = controller_with_mock_facade

        # Create test task
        test_task_id = TaskId(str(uuid.uuid4()))
        test_branch_id = uuid.uuid4()
        created_task = Task(
            id=test_task_id,
            title="New test task",
            description="Description for new test task",
            git_branch_id=test_branch_id,
            status=TaskStatus.todo(),
            priority=Priority.high(),
            assignees=["coding-agent"]
        )

        # Mock facade to return created task
        mock_facade.create_task.return_value = created_task

        # Call controller (auth disabled via fixture)
        result = await controller.manage_task(
            action="create",
            git_branch_id=str(test_branch_id),
            title="New test task",
            assignees="coding-agent"
        )

        # Verify response structure
        assert result['success'] is True
        task_data = result['task']

        # Should NOT have emoji or count fields
        assert 'priority_emoji' not in task_data
        assert 'status_emoji' not in task_data
        assert 'subtask_count' not in task_data
        assert 'assignees_count' not in task_data

    @pytest.mark.asyncio
    async def test_manage_task_update_no_emoji_count_fields(self, controller_with_mock_facade):
        """
        Verify manage_task UPDATE returns clean structure

        Tests:
        - Updated task has no emoji/count fields
        """
        controller, mock_facade = controller_with_mock_facade

        # Create test task
        test_task_id = TaskId(str(uuid.uuid4()))
        updated_task = Task(
            id=test_task_id,
            title="Updated task",
            description="Description for updated task",
            git_branch_id=uuid.uuid4(),
            status=TaskStatus.in_progress(),
            priority=Priority.critical(),
            assignees=["coding-agent", "debugger-agent"]
        )

        # Mock facade to return updated task
        mock_facade.update_task.return_value = updated_task

        # Call controller (auth disabled via fixture)
        result = await controller.manage_task(
            action="update",
            task_id=str(test_task_id),
            status="in_progress",
            priority="critical"
        )

        # Verify response structure
        assert result['success'] is True
        task_data = result['task']

        # Should NOT have emoji or count fields
        assert 'priority_emoji' not in task_data
        assert 'status_emoji' not in task_data
        assert 'assignees_count' not in task_data


class TestMCPTaskEndpointIncludeContext:
    """Test include_context parameter behavior in manage_task endpoint"""

    @pytest.fixture
    def controller_with_mock_facade(self, monkeypatch):
        """Create controller with mocked facade and disabled auth"""
        # Disable authentication for tests
        monkeypatch.setenv('AUTH_ENABLED', 'false')

        mock_task_facade_factory = Mock(spec=TaskFacadeFactory)
        mock_task_facade = Mock(spec=TaskApplicationFacade)
        mock_task_facade_factory.create_task_facade.return_value = mock_task_facade

        controller = TaskMCPController(
            facade_service_or_factory=mock_task_facade_factory
        )

        return controller, mock_task_facade

    @pytest.mark.asyncio
    async def test_include_context_false_default(self, controller_with_mock_facade):
        """
        Verify context_data excluded by default when include_context not specified

        Tests:
        - context_id IS in response
        - context_data NOT in response when include_context omitted
        """
        controller, mock_facade = controller_with_mock_facade

        # Create test task with context
        test_task_id = TaskId(str(uuid.uuid4()))
        test_context_id = uuid.uuid4()
        test_task = Task(
            id=test_task_id,
            title="Test task with context",
            description="Test task description with context",
            git_branch_id=uuid.uuid4(),
            status=TaskStatus.todo(),
            priority=Priority.medium(),
            assignees=["coding-agent"],
            context_id=test_context_id
        )

        # Mock facade to return task
        mock_facade.get_task.return_value = test_task

        # Call controller WITHOUT include_context parameter (auth disabled via fixture)
        result = await controller.manage_task(
            action="get",
            task_id=str(test_task_id)
            # include_context not specified - should default to False
        )

        # Verify response structure
        assert result['success'] is True
        task_data = result['task']

        # Should have context_id
        assert 'context_id' in task_data
        assert task_data['context_id'] == str(test_context_id)

        # Should NOT have context_data (default is False)
        # Note: context_data might not be in response at all when include_context=False
        # This is the expected behavior - no context data by default


class TestMCPSubtaskEndpointResponseStructure:
    """Test subtask serialization follows same patterns"""

    def test_subtask_entity_no_emoji_fields(self):
        """
        Verify Subtask entity serialization doesn't include emoji fields

        Tests:
        - Subtask to_dict() excludes emoji fields
        - priority/status strings are included
        """
        # Create test subtask
        test_parent_id = TaskId(str(uuid.uuid4()))
        test_subtask = Subtask(
            title="Test subtask",
            description="Test subtask description",
            parent_task_id=test_parent_id,
            status=TaskStatus.in_progress(),
            priority=Priority.high(),
            assignees=["coding-agent"]
        )

        # Serialize to dict
        subtask_dict = test_subtask.to_dict()

        # Should NOT have emoji fields
        assert 'priority_emoji' not in subtask_dict, "priority_emoji should not be in serialization"
        assert 'status_emoji' not in subtask_dict, "status_emoji should not be in serialization"

        # Should have base string fields
        assert 'priority' in subtask_dict
        assert 'status' in subtask_dict


