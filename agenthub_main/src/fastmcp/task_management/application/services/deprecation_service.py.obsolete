"""
Deprecation Service for API Response Optimization

This service manages deprecation warnings and gradual removal of redundant fields
from API responses as part of Phase 1 API response optimization.
"""

import os
import logging
from typing import Dict, Any, List, Optional
from dataclasses import dataclass

logger = logging.getLogger(__name__)


@dataclass
class DeprecationWarning:
    """Represents a deprecation warning for a field"""
    field: str
    message: str
    removal_version: str
    alternative: Optional[str] = None


class DeprecationService:
    """
    Service for managing deprecated fields in API responses.

    Supports gradual rollout via environment variables:
    - RESPONSE_NO_VISUAL_INDICATORS: Remove visual_indicators from responses
    - RESPONSE_NO_BOOLEAN_FIELDS: Remove derived boolean fields (has_context, has_dependencies)
    - RESPONSE_INCLUDE_CONTEXT_DEFAULT: Default value for include_context parameter
    """

    def __init__(self):
        """Initialize deprecation service with environment variable configuration"""
        self._load_config()

    def _load_config(self) -> None:
        """Load configuration from environment variables"""
        self.remove_visual_indicators = os.getenv(
            "RESPONSE_NO_VISUAL_INDICATORS", "false"
        ).lower() in ("true", "1", "yes", "on")

        self.remove_boolean_fields = os.getenv(
            "RESPONSE_NO_BOOLEAN_FIELDS", "false"
        ).lower() in ("true", "1", "yes", "on")

        self.include_context_default = os.getenv(
            "RESPONSE_INCLUDE_CONTEXT_DEFAULT", "false"
        ).lower() in ("true", "1", "yes", "on")

        logger.info(
            f"Deprecation config loaded: "
            f"remove_visual_indicators={self.remove_visual_indicators}, "
            f"remove_boolean_fields={self.remove_boolean_fields}, "
            f"include_context_default={self.include_context_default}"
        )

    def should_include_visual_indicators(self) -> bool:
        """
        Check if visual_indicators should be included in responses.

        Returns:
            bool: True if visual_indicators should be included (default: True for backward compatibility)
        """
        return not self.remove_visual_indicators

    def should_include_boolean_fields(self) -> bool:
        """
        Check if boolean derived fields should be included in responses.

        Returns:
            bool: True if boolean fields should be included (default: True for backward compatibility)
        """
        return not self.remove_boolean_fields

    def get_default_include_context(self) -> bool:
        """
        Get the default value for include_context parameter.

        Returns:
            bool: Default value for include_context (default: False to save tokens)
        """
        return self.include_context_default

    def add_deprecation_warnings(self, response: Dict[str, Any]) -> Dict[str, Any]:
        """
        Add deprecation warnings to response if deprecated fields are present.

        Args:
            response: API response dictionary

        Returns:
            Dict[str, Any]: Response with deprecation warnings added
        """
        warnings: List[DeprecationWarning] = []

        # Check for visual_indicators
        if "visual_indicators" in response and self.should_include_visual_indicators():
            warnings.append(DeprecationWarning(
                field="visual_indicators",
                message="The 'visual_indicators' field is deprecated and will be removed in v2.0",
                removal_version="v2.0",
                alternative="Map status/priority values to UI elements on the client side"
            ))

        # Check for has_context
        if "has_context" in response.get("task", {}) and self.should_include_boolean_fields():
            warnings.append(DeprecationWarning(
                field="has_context",
                message="The 'has_context' field is deprecated and will be removed in v2.0",
                removal_version="v2.0",
                alternative="Check if 'context_id' is not null"
            ))

        # Check for has_dependencies
        if "has_dependencies" in response.get("task", {}) and self.should_include_boolean_fields():
            warnings.append(DeprecationWarning(
                field="has_dependencies",
                message="The 'has_dependencies' field is deprecated and will be removed in v2.0",
                removal_version="v2.0",
                alternative="Check if 'dependencies' array length is greater than 0"
            ))

        # Add warnings to response if any exist
        if warnings:
            if "meta" not in response:
                response["meta"] = {}

            response["meta"]["deprecation_warnings"] = [
                {
                    "field": w.field,
                    "message": w.message,
                    "removal_version": w.removal_version,
                    "alternative": w.alternative
                }
                for w in warnings
            ]

        return response

    def filter_deprecated_fields(self, response: Dict[str, Any]) -> Dict[str, Any]:
        """
        Remove deprecated fields from response based on environment configuration.

        Args:
            response: API response dictionary

        Returns:
            Dict[str, Any]: Response with deprecated fields removed if configured
        """
        # Remove visual_indicators if configured
        if not self.should_include_visual_indicators():
            response.pop("visual_indicators", None)
            logger.debug("Removed visual_indicators from response (env flag enabled)")

        # Remove boolean derived fields if configured
        if not self.should_include_boolean_fields():
            if "task" in response:
                response["task"].pop("has_context", None)
                response["task"].pop("has_dependencies", None)
                logger.debug("Removed boolean derived fields from response (env flag enabled)")

        return response


# Singleton instance
_deprecation_service: Optional[DeprecationService] = None


def get_deprecation_service() -> DeprecationService:
    """Get singleton instance of deprecation service"""
    global _deprecation_service
    if _deprecation_service is None:
        _deprecation_service = DeprecationService()
    return _deprecation_service


def should_include_visual_indicators() -> bool:
    """Convenience function to check if visual_indicators should be included"""
    return get_deprecation_service().should_include_visual_indicators()


def should_include_context_by_default() -> bool:
    """Convenience function to get default include_context value"""
    return get_deprecation_service().get_default_include_context()
