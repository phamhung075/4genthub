#!/bin/sh
# Seat attribution for every commit made from a seat.
#
# HOW IT IS DELIVERED: as one entry in agenthub_main/.pre-commit-config.yaml, of stage
# `prepare-commit-msg`. The repository already owns the hook mechanism - .git/hooks/pre-commit is
# generated by the pre-commit framework and execs this config - so nothing is installed into the
# owner's unversioned .git/hooks, and this file needs no copy anywhere.
#
# WHY IT EXISTS: every commit in this repository carries ONE machine identity, so git cannot name the
# seat that made it. On 2026-10-08 eleven attribution instruments across five seats failed to name the
# author of a file we all needed to name. The only trailer this repository had was the runtime's
# `Claude-Session:`, which marks a RUNTIME and not a seat - so a seat field has to be written by a
# hook rather than inherited from git or from the runtime.
#
# THE VALUE IS THE ADDRESS, NOT MERELY A UNIQUE STRING. OPENRIG_SESSION_NAME exports the seat's
# `rig send` address - for example 4genthub-min-architect@4genthub-min - so a reader who finds this
# trailer can MESSAGE THE SEAT DIRECTLY. That reach-back is the property no other instrument had.
# (web-dev's six hand-written `Seat: 4genthub-min.web-dev` trailers are the precedent for the FIELD
# name and place, and not for the value: that form is the logical id, which cannot be messaged.)
#
# WHAT IT DOES NOT FIX, and saying so is part of the fix: a trailer names the seat that RAN
# `git commit`, NOT the author of every line in the commit. 0c8122a9 is the counterexample - go-dev's
# commit carried the architect's two staged lines, and a trailer there would read go-dev, which would
# be wrong for those lines. THIS HOOK AND THE PRE-COMMIT LADDER ARE ONE FIX IN TWO PARTS: the ladder
# checks that the lines are yours before you commit; the trailer records who committed them.
#
# AND THE ABSENCE MEANS SOMETHING ONLY ONCE THIS IS LIVE. The owner commits from the host, where
# OPENRIG_SESSION_NAME is unset, so the hook writes no trailer there - so an absent `Seat:` trailer
# means "not a seat". BUT THAT INFERENCE IS VALID ONLY AFTER THE HOOK IS INSTALLED: before it, seat
# commits carry no trailer either (go-dev's own did not), so an absence must be compared against the
# install commit before it is read as an answer.
#
# Reading attribution afterwards, for every seat - AND READ IT WITH GIT'S PARSER, NOT A GREP:
#     git log --format='%h %(trailers:key=Seat,valueonly)'
# A grep for a capitalised word and a colon counts PROSE: this repository's bodies contain lines like
# "Gates: ..." and "UserTaskController: ..." mid-paragraph, which a trailer census counted as trailers
# until it was re-run through `git interpret-trailers --parse`.
#
# GIT CALLS THIS AS: prepare-commit-msg <message-file> <source> [<sha>] - and the source is not read
# here, because a message, a merge and an amend are all handled the same way: one trailer at most.

set -eu

# No message file: the framework's own `run` mode passes none. Nothing to write, and never a refusal -
# a commit must not fail because an instrument had nothing to read.
if [ -z "${1:-}" ]; then
    exit 0
fi

# No seat identity in the environment: this is not a seat's commit (the owner commits from the host).
# Add nothing and never refuse the commit - an unset variable is a fact, not an error.
if [ -z "${OPENRIG_SESSION_NAME:-}" ]; then
    exit 0
fi

# --if-exists doNothing leaves a hand-written trailer alone, so a seat that already wrote one by hand
# gets no second line, and an amend cannot accumulate a third.
git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Seat: $OPENRIG_SESSION_NAME" "$1"
