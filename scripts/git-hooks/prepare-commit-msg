#!/bin/sh
# Seat attribution for every commit made from a seat.
#
# WHY THIS EXISTS: every commit in this repository carries ONE machine identity, so git cannot name
# the seat that made it. On 2026-10-08 eleven attribution instruments across five seats failed to
# name the author of a file we all needed to name. This hook appends one trailer line instead, from
# the environment the seat already has, so nobody has to remember anything.
#
# THE VALUE IS THE ADDRESS, NOT MERELY A UNIQUE STRING. OPENRIG_SESSION_NAME exports the seat's
# `rig send` address - for example 4genthub-min-architect@4genthub-min - so a reader who finds this
# trailer can MESSAGE THE SEAT DIRECTLY. That reach-back is the property no other attribution
# instrument had.
#
# WHAT IT DOES NOT FIX, and saying so is part of the fix: a trailer names the seat that RAN
# `git commit`, NOT the author of every line in the commit. 0c8122a9 is the counterexample - go-dev's
# commit carried the architect's two staged lines, and a trailer there would read go-dev, which would
# be wrong for those lines. THIS HOOK AND THE PRE-COMMIT LADDER ARE ONE FIX IN TWO PARTS: the ladder
# checks that the lines are yours before you commit; the trailer records who committed them. Neither
# one alone attributes a line.
#
# AND THE ABSENCE MEANS SOMETHING POSITIVE. The owner commits from the host, where
# OPENRIG_SESSION_NAME is unset, so this hook writes no trailer there. A commit WITHOUT a `Seat:`
# trailer therefore says "not a seat" - which would have answered 2026-10-08's question in one
# `git log`, instead of eleven instruments.
#
# IT DOES NOT INSTALL ITSELF. This file is versioned; the hook directory is not, and it belongs to the
# owner's environment. The install is one approved step by the owner:
#
#     scripts/git-hooks/prepare-commit-msg --check        # is the path free? report, never overwrite
#     cp scripts/git-hooks/prepare-commit-msg .git/hooks/prepare-commit-msg
#     chmod +x .git/hooks/prepare-commit-msg
#
# Reading attribution afterwards, for every seat:
#     git log --format='%h %(trailers:key=Seat,valueonly)'
#
# GIT CALLS THIS AS: prepare-commit-msg <message-file> <source> [<sha>] - and the source is not read
# here, because a message, a merge and an amend are all handled the same way: one trailer at most.

set -eu

message_file="${1:-}"

# THE GUARD, FIRST, AND IT ONLY REPORTS. Somebody else's hook is somebody else's work, and every
# commit in this repository now passes through this path - so the check is a mode that installs
# nothing and says what it found.
if [ "$message_file" = "--check" ]; then
    hook_path="$(git rev-parse --git-dir)/hooks/prepare-commit-msg"
    if [ -e "$hook_path" ]; then
        echo "OCCUPIED: $hook_path already exists - stop and report it rather than overwriting." >&2
        exit 1
    fi
    echo "free: $hook_path does not exist, so the install may proceed."
    exit 0
fi

# No seat identity in the environment: this is not a seat's commit (the owner commits from the host).
# Add nothing and never refuse the commit - an unset variable is a fact, not an error.
if [ -z "${OPENRIG_SESSION_NAME:-}" ]; then
    exit 0
fi

# --if-exists doNothing leaves a hand-written trailer alone, so a seat that already wrote one by hand
# gets no second line, and an amend cannot accumulate a third.
git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Seat: $OPENRIG_SESSION_NAME" "$message_file"
