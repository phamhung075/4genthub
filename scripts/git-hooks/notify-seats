#!/usr/bin/env bash
# post-commit: tell every running seat that the project moved, so it re-reads what it is about to edit.
# Never fails a commit: a room that is down, a seat that is busy or a send that is unconfirmed is skipped.
set -u
state="${AGENTHUB_STATE_DIR:-$HOME/.config/4genthub}"
sha=$(git rev-parse --short HEAD) || exit 0
subject=$(git log -1 --format=%s)
files=$(git show --name-only --format= HEAD | head -15)
total=$(git show --name-only --format= HEAD | wc -l)
message="New commit $sha on $(git rev-parse --abbrev-ref HEAD): $subject
Files ($total): $(echo "$files" | tr '\n' ' ')
Re-read any of these files before you edit them; a client change is only live after a build and a reseat."
# main is the only reference. A seat whose tree lacks main's commits is told so, with the count.
# The three reads INSIDE behind_note must not inherit the hook's git environment: a post-commit hook
# in a linked worktree receives GIT_DIR=<main>/.git/worktrees/<wt>, and `git -C <path>` does NOT
# override an exported GIT_DIR, so both the "is this a tree" guard and the count would answer for the
# COMMITTER's checkout. Measured 2026-10-15 (qitem-20261015175221): every seat was told the
# committer's revision and distance instead of its own. The sha is computed into a variable for the
# same reason - a $( ) inside printf inherits the environment too.
# The path is the seat's PANE cwd, which is the room's launch directory, so in a room whose seats edit
# in worktrees of their own this note stays silent unless a seat is launched INTO its worktree. That is
# deliberate: naming the seat's worktree needs a seat -> worktree map, and there is more than one.
tmux_root="$state/tmux"
behind_note() {
    local session="$1" path behind head
    path=$(env -u TMUX TMUX_TMPDIR="$tmux_root" tmux display-message -p -t "$session" '#{pane_current_path}' 2>/dev/null) || return 0
    [ -n "$path" ] && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || return 0
    head=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR git -C "$path" rev-parse --short HEAD 2>/dev/null) || return 0
    behind=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR git -C "$path" rev-list --count HEAD..main 2>/dev/null) || return 0
    [ "${behind:-0}" -gt 0 ] || return 0
    printf '\nWARNING: your tree (%s at %s) is %s commit(s) behind main. Only main is the reference: update it (git merge main or rebase onto main) before you continue, and re-read the files above.' \
        "$path" "$head" "$behind"
}
for dir in "$state"/rooms/*/; do
    room=$(basename "$dir")
    case "$room" in *.obsolete*) continue ;; esac
    timeout 10 4genteam room status "$room" 2>/dev/null | awk '$3 == "running" { print $1, $4 }' | while read -r seat session; do
        # The committing seat is not told about its own commit: the send is refused as a self message
        # ("4genteam send <me> ..." over no link), and a refusal per commit per room is pure audit noise.
        [ "$session" = "${AGENTHUB_SESSION_NAME:-}" ] && continue
        timeout 10 4genteam send --from git-hook --intent notice "$room" "$seat" "$message$(behind_note "$session")" >/dev/null 2>&1 || true
    done
done
exit 0
